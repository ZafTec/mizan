{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/mizan-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{RequestId}] [{UserId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/mizan-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{RequestId}] [{UserId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=mizan;Username=mizan;Password=mizan_dev_password",
    "Redis": ""
  },
  "App": {
    "PublicUrl": "http://localhost:3000",
    "CookieDomain": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@mizan.local",
    "FromName": "Mizan",
    "UseStartTls": true
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "GitHub": { "ClientId": "", "ClientSecret": "" }
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "auto",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Bucket": "mizan",
    "ForcePathStyle": true,
    "PublicBaseUrl": "",
    "PresignedUrlMinutes": 60,
    "MaxUploadBytes": 5242880
  },
  "Ai": {
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "gpt-5.6-luna",
    "MaxOutputTokens": 1024,
    "TimeoutSeconds": 60,
    "Free": { "DailyRequests": 5, "DailyTokens": 20000 },
    "Pro": { "DailyRequests": 200, "DailyTokens": 500000 },
    "GlobalDailyTokens": 5000000,
    "GlobalDailyCostMicros": 20000000,
    "PromptCostPerMillionMicros": 150000,
    "CompletionCostPerMillionMicros": 600000
  },
  "Paddle": {
    "Environment": "sandbox",
    "ApiKey": "",
    "WebhookSecret": "",
    "GraceDays": 3,
    "LifetimePriceId": "pri_01kwa2qt2c0q0ntgp0ntrn3tbt"
  },
  "AllowedHosts": "*"
}