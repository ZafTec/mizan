# Mizan Environment Variables
# For Development: Copy this file to .env.local
# For Production: Copy this file to .env and update values

# === Database (PostgreSQL) ===
# Only the backend talks to the database. The frontend owns no tables since v2
# and needs no DATABASE_URL - see docs/REFOCUS.md §6.
DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=
MCP_SERVICE_KEY=
MCP_ADMIN_SERVICE_KEY=

# === Telegram bot ===
# All optional. With no token the bot service starts and idles, and the
# Telegram settings page is hidden - nothing else changes.
# BOT_USERNAME is the @name without the @; the API needs it to build the
# t.me deep link that carries a link code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Long polling in development. Set true in production and point nginx at
# /telegram/webhook on the bot container.
TELEGRAM_USE_WEBHOOK=false
# Checked against X-Telegram-Bot-Api-Secret-Token on every webhook call.
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=


# === Backend API URLs ===
# Server-side: Internal Docker network URL (docker-compose) or localhost (local dev)
API_URL=http://backend:8080
# Client-side: Browser-accessible backend URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# === Identity (backend-owned) ===
# Where the web app lives. Verification and reset links point here, and OAuth
# returns here.
PUBLIC_APP_URL=https://mizan.zaftech.co

# Parent domain shared by the app and the API, so one session cookie covers
# both. Leave empty for localhost, where the cookie is host-only.
COOKIE_DOMAIN=.mizan.zaftech.co

# === Backend Configuration (.NET) ===
# Connection strings (PostgreSQL)
ConnectionStrings__PostgreSQL=Host=postgresql-db;Port=5432;Database=mizan;Username=admin;Password=CHANGE_ME;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=1024;Timeout=15;CommandTimeout=30;Ssl Mode=Prefer;Trust Server Certificate=true;

# Connection strings (Redis)
ConnectionStrings__Redis=redis:6379,password=CHANGE_ME,abortConnect=false,connectTimeout=5000,syncTimeout=1000

# CORS Origins
Cors__Origins__1=https://mizan.zaftech.co


# === AI assistant ===
# Any OpenAI-compatible /chat/completions endpoint. Empty disables the
# assistant; the API still starts and only the AI surfaces refuse.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
# The circuit breaker on the whole provider bill, per UTC day.
AI_GLOBAL_DAILY_TOKENS=5000000
AI_GLOBAL_DAILY_COST_MICROS=20000000

# === Paddle Billing ===
# Backend (.NET) - server-side, secret
Paddle__Environment=sandbox            # sandbox | production
Paddle__ApiKey=                        # server-side API key (sandbox key for dev)
Paddle__WebhookSecret=                 # signing secret from the notification destination
Paddle__GraceDays=3                    # past_due grace window before downgrade

# Frontend (Next.js) - client-side
NEXT_PUBLIC_PADDLE_ENV=sandbox         # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=       # client-side token (sandbox)
# Price id (sandbox value created for dev; replace with the production id when promoting).
# One plan, one price - Yearly and Lifetime were dropped from sale; a
# LifetimePriceId remains supported server-side only to recognize the grants
# already issued to existing lifetime customers, never to sell a new one.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_01kwa2qsjb9zryjeynbb7se47p

# === Cloudinary (Image Uploads) ===
# S3-compatible object storage. One implementation covers both:
#   MinIO  STORAGE_SERVICE_URL=https://minio.example        STORAGE_REGION=us-east-1
#   R2     STORAGE_SERVICE_URL=https://<account>.r2.cloudflarestorage.com  STORAGE_REGION=auto
STORAGE_SERVICE_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=mizan
# Origin that serves the bucket publicly - an R2 custom domain or r2.dev host,
# or whatever fronts a public MinIO bucket. Leave empty and reads fall back to
# presigned URLs, which work but expire and defeat CDN caching.
STORAGE_PUBLIC_BASE_URL=

# === Email/SMTP (Password Reset & Verification) ===
# Read by the backend (Smtp__*). Leave the host empty in development and the
# API logs the link instead of sending it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=Mizan <noreply@mizan.example.com>

# === OAuth Providers (Optional) ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# === E2E Testing (Playwright) ===
# Optional overrides for running Playwright against docker-compose services
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_BACKEND_URL=http://localhost:5000

# === Environment Variable Types (Next.js) ===
#
# NEXT_PUBLIC_* variables (BUILD-TIME):
# - These are BAKED into the JavaScript bundle during build
# - Cannot be changed without rebuilding the Docker image
# - Set in Dockerfile.prod as ARG/ENV
# - Examples: NEXT_PUBLIC_API_URL, NEXT_PUBLIC_MEDIA_URL
#
# Server-side variables (RUNTIME):
# - These are evaluated at runtime when server code runs
# - Can be changed via .env file without rebuilding
# - Examples: DB_PASSWORD, SMTP_PASS, MCP_SERVICE_KEY
#
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# === Production Security Notes ===
# 1. Generate strong random secrets:
#    openssl rand -base64 32
#
# 2. PUBLIC_APP_URL must match your public domain exactly
#    This is used for email verification links and JWT issuer
