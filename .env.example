# Mizan development environment
# Copy this file to .env for docker-compose.yml.
# Production uses the separate settings in docker-compose.prod.yml.

# === Database (PostgreSQL) ===
# Only the backend talks to the database. The frontend owns no tables since v2
# and needs no DATABASE_URL - see docs/ARCHITECTURE.md#identity.
DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=
MCP_SERVICE_KEY=
MCP_ADMIN_SERVICE_KEY=

# === Telegram bot ===
# The bot's token, username, webhook switch and secret and the Mini App URL
# are runtime settings in Admin, Settings (docs/TELEGRAM.md#configure-and-run).
# The bot service reads them from the API with MCP_SERVICE_KEY.
# IPs or CIDR ranges, comma-separated, whose X-Forwarded-For the bot believes
# when it records a Mini App session's address. Use the Docker network that
# nginx and the frontend share, for example the output of
# docker network inspect proxy-net --format '{{(index .IPAM.Config 0).Subnet}}'.
# Empty in production trusts loopback only; development Compose defaults to
# 172.16.0.0/12.
TELEGRAM_TRUSTED_PROXIES=


# === Backend API URLs ===
# Server-side: Internal Docker network URL (docker-compose) or localhost (local dev)
API_URL=http://backend:8080
# Server-side: the Telegram bot service. Next.js forwards the Mini App's
# POST /telegram/miniapp/session here when the reverse proxy does not route
# that path to the bot itself (local development). Never exposed to the browser.
TELEGRAM_BOT_URL=http://telegram:5002
# Client-side: Browser-accessible backend URL. In production this is the same
# origin as the app itself (the API lives at /api on that domain, not a
# separate subdomain) - only local dev points at a different port.
NEXT_PUBLIC_API_URL=http://localhost:5000

# === Identity (backend-owned) ===
# Where the web app lives. Verification and reset links point here, and OAuth
# returns here.
PUBLIC_APP_URL=https://mizan.zaftech.co

# Cookie domain override. Leave empty - the app, API (/api) and MCP server
# (/mcp) all live on the same host now, so the session cookie is host-only
# and needs no Domain attribute in any environment.
COOKIE_DOMAIN=

# === Backend Configuration (.NET) ===
# Connection strings (PostgreSQL)
ConnectionStrings__PostgreSQL=Host=postgresql-db;Port=5432;Database=mizan;Username=admin;Password=CHANGE_ME;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=1024;Timeout=15;CommandTimeout=30;Ssl Mode=Prefer;Trust Server Certificate=true;

# Connection strings (Redis)
ConnectionStrings__Redis=redis:6379,password=CHANGE_ME,abortConnect=false,connectTimeout=5000,syncTimeout=1000

# CORS Origins
Cors__Origins__1=https://mizan.zaftech.co


# === Runtime settings ===
# Email, storage, the AI provider and its limits, Telegram, push, billing,
# OAuth token lifetimes, outbox tuning and the price crawler are not
# environment variables. An administrator sets them in Admin, Settings and
# they apply without a restart (docs/ADMIN.md#runtime-settings). Create the
# first administrator with `Mizan.Api --create-admin you@example.com`.
# Google and GitHub sign-in are runtime settings too (Admin, Settings, Sign-in).
# An older .env that still holds SMTP_*, AI_*, STORAGE_*, TELEGRAM_*, Paddle__*,
# GOOGLE_*, GITHUB_* or NEXT_PUBLIC_PADDLE_* values: run `Mizan.Api --import-env-settings` once to copy them in
# (docs/ADMIN.md#moving-settings-out-of-the-environment).

# === Paddle Billing ===
# Every Paddle value, including the client-side token and environment the
# browser opens checkout with, is a runtime setting (Admin, Settings, Billing).
# Prices are not configured here: admins create and edit them at /admin/billing,
# which creates them in Paddle.

# === Frontend Telemetry (Grafana Faro) ===
# Browser RUM (errors, traces, web vitals). Empty disables it entirely - no
# script loads, no data leaves the browser. Points at a Faro receiver
# (Grafana Alloy or Grafana Cloud); this deployment's is proxied through
# https://zaftech.co/collect.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=mizan-frontend

# === Local MinIO (development Compose only) ===
# Root credentials and bucket for the minio container, which minio-init
# creates and opens for download. The API does not read these: set
# Storage.ServiceUrl=http://minio:9000, Storage.Region=us-east-1, the same key
# pair and Storage.PublicBaseUrl in Admin, Settings, or import them once.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=mizan
# Where browsers read uploads, such as http://localhost:9000/mizan. Development
# Compose passes it to next/image's hostname allowlist as NEXT_PUBLIC_MEDIA_URL.
STORAGE_PUBLIC_BASE_URL=
# The production frontend build reads this GitHub repository variable for
# next/image's hostname allowlist. Match Storage.PublicBaseUrl and rebuild
# when the host changes. For host builds, set it in frontend/.env.local.
NEXT_PUBLIC_MEDIA_URL=

# === E2E Testing (Playwright) ===
# Optional overrides for running Playwright against docker-compose services
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_BACKEND_URL=http://localhost:5000

# === Environment Variable Types (Next.js) ===
#
# NEXT_PUBLIC_* variables (BUILD-TIME):
# - These are BAKED into the JavaScript bundle during build
# - Cannot be changed without rebuilding the Docker image
# - Set in Dockerfile.prod as ARG/ENV
# - Examples: NEXT_PUBLIC_API_URL, NEXT_PUBLIC_MEDIA_URL
#
# Server-side variables (RUNTIME):
# - These are evaluated at runtime when server code runs
# - Can be changed via .env file without rebuilding
# - Examples: DB_PASSWORD, MCP_SERVICE_KEY
#
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# === Production Security Notes ===
# 1. Generate strong random secrets:
#    openssl rand -base64 32
#
# 2. PUBLIC_APP_URL must match your public domain exactly
#    This is used for email verification links and OAuth callbacks
